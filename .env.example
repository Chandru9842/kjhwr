# ==============================================================================
# UK Wind Intelligence - Environment Configuration (.env.example)
# Copy this file to .env for local Docker Compose or platform deployments.
# DO NOT commit .env files containing real secrets to source control.
# ==============================================================================

# --- Frontend Configuration ---
# Target URL for backend API requests initiated from client browsers.
# In local development / Docker Compose: http://localhost:8000
# In production (e.g. Vercel): https://<your-backend-app>.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# --- Backend Configuration ---
# Public Elexon BMRS API base endpoint
BMRS_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Optional: Elexon BMRS Scripting API Key for elevated rate limits.
# Public BMRS endpoints function without an API key for baseline usage.
BMRS_API_KEY=

# Day-Ahead Gate Closure cutoff time in UTC (HH:MM format, default: 12:00)
DEFAULT_CUTOFF_TIME=12:00

# Default analysis date window (YYYY-MM-DD)
DEFAULT_START_DATE=2026-01-01
DEFAULT_END_DATE=2026-01-31

# Caching & Reliability Settings
CACHE_ENABLED=true
CACHE_TTL_HOURS=24
HTTP_TIMEOUT_SECONDS=30.0
MAX_CHUNK_DAYS=6
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0

# CORS Allowed Origins (comma-separated list)
# Include your frontend origin here (e.g., https://your-app.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
