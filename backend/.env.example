# ==============================================================================
# UK Wind Intelligence - Backend Configuration (.env.example)
# ==============================================================================

# Elexon BMRS API Base Endpoint
BMRS_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Optional Scripting API Key (Leave empty to use public unauthenticated endpoint)
BMRS_API_KEY=

# Day-Ahead Decision Gate Closure cutoff in UTC (HH:MM format)
DEFAULT_CUTOFF_TIME=12:00

# Default historical settlement analysis dates
DEFAULT_START_DATE=2026-01-01
DEFAULT_END_DATE=2026-01-31

# Caching Configuration
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# HTTP Client Timeouts & Chunking
HTTP_TIMEOUT_SECONDS=30.0
MAX_CHUNK_DAYS=6
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Server Port (automatically mapped by hosting providers such as Render)
PORT=8000
